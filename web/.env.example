# --- Database (Neon) --- get BOTH from Neon Console → Connect
DATABASE_URL="postgresql://USER:PASSWORD@EP-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"  # pooled — app
DIRECT_URL="postgresql://USER:PASSWORD@EP-xxxx.REGION.aws.neon.tech/DB?sslmode=require"           # direct — migrations

# --- Auth (Clerk) --- chunk 0.2; get keys from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Platform super-admins (chunk 0.2) --- comma-separated Clerk user IDs (include yours)
PLATFORM_ADMIN_USER_IDS=

# --- Clerk webhook (chunk 0.3) --- Clerk Dashboard → Webhooks → signing secret (whsec_...)
CLERK_WEBHOOK_SECRET=

# --- Credential vault (chunk 1.1) --- 32-byte base64 key, generate later
ENCRYPTION_KEY=

# --- Platform AI key for label scan (chunk 1.2) ---
ANTHROPIC_API_KEY=

# --- Observability / Sentry (chunk 3.3) --- last step: set in Vercel, then redeploy
# Browser + server DSN (the public one is safe to expose). Leave unset to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map upload (build-time only) — Sentry → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional: override the log level (default "info")
LOG_LEVEL=

# --- Google Sheets order export --- Google Cloud → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorized redirect URI:
#   https://<app>/api/integrations/google/oauth/callback
# Enable the "Google Sheets API" in the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Conversions API (server-side Purchase for the COD form) ---
# Events Manager → pixel → Settings → Conversions API → Generate access token.
# Uses COD_FORM_PIXEL_ID. Leave the token empty to keep browser-only events.
META_CAPI_TOKEN=
# Optional: test code from Events Manager → Test events (remove after testing)
META_TEST_EVENT_CODE=
# Optional: Graph API version (default v24.0)
META_GRAPH_VERSION=
